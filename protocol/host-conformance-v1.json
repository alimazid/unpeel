  "additiveBootstrapFields": [
    {
      "field": "availableApps",
      "required": true,
      "note": "Official Host catalog, including missing Apps, for install prompts and Settings."
    },
    {
      "field": "installedApps",
      "required": true,
      "note": "Live Host PATH subset of availableApps."
    },
    {
      "field": "openers",
      "required": true,
      "note": "Host-owned typed resource selector to app/editor/system preference map."
    },
    {
      "field": "appPresentations",
      "required": true,
      "note": "Validated semantic App companion bindings, including reveal revisions, for pane projection in local and remote Controllers."
    },
    {
      "field": "hostIsolationTier",
      "required": true,
      "values": [
        "vm",
        "container",
        "host"
      ],
      "note": "Router-owned, data only. Both Host kinds always publish it; macOS is host. Controllers treat an absent value as unknown (compatibility with pre-0.5.0 Hosts)."
    },
    {
      "field": "hostEnvironment",
      "required": false,
      "shape": {
        "kind": "box",
        "id": "<string>"
      },
      "note": "Present only when the Host detects it runs inside a Box (kind box). Additive/optional; no policy in 0.5.0."
    },
    {
      "field": "schedulesRevision",
      "required": false,
      "note": "Fork-only: Scheduled Tasks. Opaque; changes whenever GET /mobile/schedules or a task's GET /mobile/schedules/runs would answer differently. Controllers refetch the schedules routes when it moves instead of polling them. Absent on Hosts without the schedules capability."
    },
    {
      "field": "presets[].agentPreset",
      "required": false,
      "note": "Fork-only: Scheduled Tasks. On every preset row: whether the preset is an Agent Preset (its command starts a runtime that shows a readiness signal at launch: a [screen] idle prompt or its own program status), the only kind that takes a task's instructions. Controllers show the Instructions field only when it is true and never classify a command themselves; absent (an older Host) reads as false."
    },
    {
      "field": "presets[].bypassesApprovals",
      "required": false,
      "note": "Fork-only: Scheduled Tasks. On every preset row: whether the preset's command passes one of its runtime's declared approval-bypass flags (runtimes/<slug>/runtime.toml [approvals]), so its Runs act with no one asked. Controllers warn from this field alone and never parse a command's flags; absent (an older Host) reads as false."
    },
    {
      "field": "sessions[].keptOutput",
      "required": false,
      "note": "Fork-only: Scheduled Tasks (ADR 0006). true on a stopped Run Session's row (`scheduleID` set, `status` exited) whose output.bin still holds bytes past its retention floor; omitted otherwise. A Controller shows that output, read-only, through the existing session.output.read route (a GET /mobile/output tail read without an offset) instead of its stopped placeholder; absent (an older Host, or nothing kept) shows the placeholder."
    },
    {
      "field": "sessions[].detectedLocalURLs",
      "required": false,
      "note": "Fork-only (#63). On a running Session's row: the loopback URLs it serves as browsable pages, the Host's live-probed list (a dead server drops out). Only a Controller on the Host's own machine can open them; others ignore the field. Omitted when empty and on stopped rows; absent (an older Host) reads as none."
    }
  ],
  "scheduleWriteRefusals": {
    "note": "Fork-only: Scheduled Tasks. Every write route's error body is {\"error\": <message>, \"code\": <code>}. Controllers branch on `code` (never the message) and show the message for a code they do not know; codes are additive. `codes` is the whole vocabulary; `cases` are refusals a Host gives with a catalog of Project `p` (folder /work) and presets `ok` (a script) and `claude` (an Agent Preset), on a clock where 2020 has passed. A case with `withoutHost` is a process with no workspace worker.",
    "codes": [
      {
        "code": "invalid_request",
        "status": 400,
        "meaning": "a malformed body, field or task name"
      },
      {
        "code": "forbidden",
        "status": 403,
        "meaning": "this principal may not change Scheduled Tasks"
      },
      {
        "code": "unknown_task",
        "status": 404,
        "meaning": "no such Scheduled Task (it may have been deleted)"
      },
      {
        "code": "invalid_trigger",
        "status": 400,
        "meaning": "the Trigger does not read or never comes due"
      },
      {
        "code": "trigger_in_past",
        "status": 400,
        "meaning": "a Once time that has passed, on an enabled task"
      },
      {
        "code": "project_missing",
        "status": 400,
        "meaning": "no Project, an unknown one, or one with no folder"
      },
      {
        "code": "preset_missing",
        "status": 400,
        "meaning": "no preset, an unknown one, or one turned off"
      },
      {
        "code": "not_agent_preset",
        "status": 400,
        "meaning": "instructions on a preset that is not an Agent Preset"
      },
      {
        "code": "instructions_too_large",
        "status": 400,
        "meaning": "instructions longer than one create may type"
      },
      {
        "code": "run_in_progress",
        "status": 409,
        "meaning": "Run now while a Run of the task is in progress"
      },
      {
        "code": "run_log_unreadable",
        "status": 500,
        "meaning": "Run now on a task whose Run log cannot be read, so the Host cannot tell whether a Run is in progress"
      },
      {
        "code": "run_no_answer",
        "status": 504,
        "meaning": "the Host did not answer Run now in time; the Run may still start"
      },
      {
        "code": "host_unavailable",
        "status": 503,
        "meaning": "no workspace worker, or it has not published its catalog yet"
      },
      {
        "code": "internal",
        "status": 500,
        "meaning": "the Host could not read or write its state"
      }
    ],
    "cases": [
      {
